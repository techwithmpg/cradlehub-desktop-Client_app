{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-api",
  "description": "Scoped native HTTP transport capability for hosted CradleHub API",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://www.cradlewellnessliving.com/api/desktop/v1/*"
        }
      ]
    }
  ]
}
